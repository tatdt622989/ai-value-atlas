PORT=4318
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_value_atlas
# Set a random token of at least 32 characters for protected editorial API operations.
ADMIN_TOKEN=
# Optional automation. No API calls are made without these values.
AI_API_KEY=
AI_RESEARCH_MODEL=
AI_REVIEW_MODEL=
AI_API_BASE=https://api.openai.com/v1
ARTIFICIAL_ANALYSIS_API_KEY=
# Collector runs daily at 01:00 UTC (09:00 Taipei); LLM changes always enter review first.
UPDATE_SCHEDULE_ENABLED=false
UPDATE_HOUR_UTC=1
AUTO_PUBLISH=false
MAX_AI_CALLS_PER_RUN=6
