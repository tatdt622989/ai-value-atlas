{
  "name": "ai-value-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "vite build && tsup server/index.ts server/cli.ts --format esm --out-dir dist-server --target node24 --sourcemap",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "atlas": "node --env-file-if-exists=.env --import tsx server/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "cheerio": "^1.2.0",
    "hono": "^4.13.7",
    "mongodb": "^7.6.0",
    "vue": "^3.5.42",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
